#!/bin/bash

log_error() {
    echo "[ERROR] $1" >&2
  }

help_page() {
  echo "Script usato per salvare i file di configurazione nel formato json"
  echo "  usage: $0 -n namespace"
}
      
# Parse optional -n <namespace>
TARGET_NS=""
while getopts "hn:" opt; do
  case $opt in
    h) help_page; exit 1 ;;
    n) TARGET_NS=("$OPTARG") ;;
    \?) log_error "Invalid option: -$OPTARG"; help_page; exit 1 ;;
    :) log_error "Option -$OPTARG requires an argument."; echo ""; help_page; exit 1 ;;
  esac
done

# Se viene passato -n usa solo quel namespace
if [[ -n "$TARGET_NS" ]]; then
  namespace=("$TARGET_NS")
else
  namespace=($(kubectl get ns -o custom-columns='name:.metadata.name' --no-headers \
  | egrep -v 'cdi|cohesity|default|diamanti|dmt|kube'))
fi

# Recupera nomi VM per creare directory
vmname=()
for ns in "${namespace[@]}"; do
  vms_in_ns=($(kubectl get vm -n "$ns" -o custom-columns='name:.metadata.name' --no-headers 2>/dev/null))
  for vm in "${vms_in_ns[@]}"; do
    vmname+=("$vm")
  done
done

# Rimuovi la vecchia directory kubevirt
if [[ -n "$TARGET_NS" ]]; then
  rm -drf "${HOME}/kubevir/${TARGET_NS}"
else
  rm -drf "${HOME}/kubevirt"
fi

# Crea directory per ciascuna VM
for dir in "${vmname[@]}"; do
  mkdir -p "${HOME}/kubevirt/${dir}" || log_error "Failed to create directory for $dir"
done

# Per ogni namespace, cerca VM, PVC, SVC
for ns in "${namespace[@]}"; do
  echo "Processing namespace: $ns"

  vms=($(kubectl get vm -n "$ns" -o custom-columns='name:.metadata.name' --no-headers 2>/dev/null))

  ########################################
  # VM (singole)
  ########################################
  for vm in "${vms[@]}"; do
    json=$(kubectl get vm "$vm" -n "$ns" -o json | jq '
      del(.status) |
      .metadata |= del(.managedFields,
      .annotations,
      .creationTimestamp,
      .finalizers,
      .generation,
      .labels,
      .resourceVersion,
      .uid)
    ' 2>/dev/null)

    [[ -n "$json" ]] && echo "$json" > "${HOME}/kubevirt/${vm}/vm_${vm}.json"
  done

  ########################################
  # PVC (multipli)
  ########################################
  pvcs=($(kubectl get pvc -n "$ns" -o custom-columns='name:.metadata.name' --no-headers 2>/dev/null))

  index=1
  for pvc in "${pvcs[@]}"; do
    json=$(kubectl get pvc "$pvc" -n "$ns" -o json | jq '
      del(.status) |
      .metadata |= del(.managedFields,
      .annotations,
      .creationTimestamp,
      .finalizers,
      .labels,
      .resourceVersion,
      .uid)
    ' 2>/dev/null)

    # Associa PVC alle VM presenti nel namespace
    for vm in "${vms[@]}"; do
      [[ -n "$json" ]] && echo "$json" > "${HOME}/kubevirt/${vm}/pvc_${vm}_${index}.json"
    done

    index=$((index+1))
  done

  ########################################
  # SVC (multipli)
  ########################################
  svcs=($(kubectl get svc -n "$ns" -o custom-columns='name:.metadata.name' --no-headers 2>/dev/null))

  index=1
  for svc in "${svcs[@]}"; do
    json=$(kubectl get svc "$svc" -n "$ns" -o json | jq '
      del(.status) |
      .metadata |= del(.managedFields,
      .annotations,
      .creationTimestamp,
      .labels,
      .resourceVersion,
      .uid) |
        .spec |= del(.clusterIP,
        .clusterIPs,
        .internalTrafficPolicy,
        .ipFamilies,
        .ipFamilyPolicy,
      .sessionAffinity)
    ' 2>/dev/null)

    for vm in "${vms[@]}"; do
      [[ -n "$json" ]] && echo "$json" > "${HOME}/kubevirt/${vm}/svc_${vm}_${index}.json"
    done

    index=$((index+1))
  done

done

echo "✅   Script completato. I file JSON sono stati salvati in ${HOME}/kubevirt/"
